@model WebAppPelda.Models.Customer

@{
    ViewData["Title"] = "Vásárló törlése";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Vásárló törlése</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Home" asp-action="DeleteCustomer" method="post" class="needs-validation" novalidate>

        <div class="mb-3">
            <label asp-for="Id" class="form-label">Id:</label>
            <input asp-for="Id" type="number" class="form-control" placeholder="1" />
        </div>

        <button type="submit" class="btn btn-danger w-100">Törlés</button>
    </form>
</div>
